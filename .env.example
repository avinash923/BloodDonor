# =================================================================
# Environment Configuration Template
# Project: AI-Based Time-Aware Emergency Blood Donor Recommendation and Dynamic Recruitment System
#
# DO NOT COMMIT REAL SECRETS TO GIT.
# Copy this file to .env and configure local secrets.
# =================================================================

# Routing Provider: 'osrm' (default when the server is started directly), 'synthetic' or 'google'
# 'osrm': Free OpenStreetMap road routing via an OSRM server, no API key. Durations are free-flow
#         (no live traffic). If OSRM is unreachable, ETAs fall back to the synthetic engine and are
#         labelled 'synthetic_fallback'.
# 'synthetic': Deterministic local distance/congestion estimate (offline-safe, used by the tests)
# 'google': Google Maps Platform Routes API (requires GOOGLE_MAPS_API_KEY)
ROUTING_PROVIDER=osrm

# OSRM server. The public demo server is free but rate-limited and has no uptime guarantee;
# self-host OSRM (https://github.com/Project-OSRM/osrm-backend) for production use.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=8

# Google Maps Platform Routes API Server-Side API Key
# Required only when ROUTING_PROVIDER=google
# RESTRICTION GUIDELINES:
#   1. Restrict key in Google Cloud Console to 'Routes API' only.
#   2. Apply server-side IP restrictions or application restrictions.
#   3. NEVER embed this key in the mobile / Flutter client.
GOOGLE_MAPS_API_KEY=

# Routing Options
GOOGLE_MAPS_TRAVEL_MODE=DRIVE
GOOGLE_MAPS_ROUTING_PREFERENCE=TRAFFIC_AWARE
GOOGLE_MAPS_TIMEOUT_SECONDS=10.0
GOOGLE_MAPS_MAX_BATCH_SIZE=100
GOOGLE_MAPS_MAX_RETRIES=2

# Local demo account login (donor_001 / staff_001) is enabled by default.
# Registered donors always require their password. Set false outside local demos.
ALLOW_DEMO_LOGIN=true

# Optional operator-controlled push/SMS gateway. Both settings are required.
# Gateway must map donor_id to an opted-in delivery address and deduplicate Idempotency-Key.
# HTTP 2xx means the gateway accepted the event, not that the donor received it.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
